{
  "name": "swissgass",
  "productName": "Swissgass",
  "version": "0.16.1",
  "description": "Tutto il Canton Ticino a regioni, con dati swisstopo e OpenStreetMap",
  "main": "main.js",
  "author": "Simone",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac --publish never",
    "build:win": "electron-builder --win --publish never"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ch.droneticino.motoracingworld.anteprima",
    "productName": "Swissgass",
    "asar": false,
    "files": [
      "main.js",
      "aggiornamenti.js",
      "regioni_main.js",
      "preload.js",
      "index.html",
      "stile.css",
      "grafica/**/*",
      "src/**/*",
      "dati/**/*",
      "cantone/**/*",
      "modelli/**/*",
      "terzi/**/*",
      "node_modules/three/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon-mac.png",
      "identity": "-",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Swissgass-${version}-Mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon-win.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Swissgass-${version}-Windows-Installazione.${ext}"
    },
    "portable": {
      "artifactName": "Swissgass-${version}-Windows-Portatile.${ext}"
    }
  }
}
